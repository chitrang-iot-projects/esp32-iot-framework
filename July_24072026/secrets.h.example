#pragma once

// Copy this file to secrets.h and fill in the two shared values below.
// secrets.h is gitignored. These values are IDENTICAL on every board — there
// is nothing per-board here, so the same firmware binary flashes to all units.

// Shared provisioning key — must equal the platform's PROVISION_KEY env var.
// (Value is in home-automation-platform/.secrets/mqtt-credentials.txt.)
#define SECRET_PROVISION_KEY  "REPLACE_WITH_PROVISION_KEY"

// Platform API base URL (no trailing slash).
#define SECRET_API_BASE       "https://REPLACE_WITH_API_HOST"

// ---------------------------------------------------------------------------
// PER-BOARD ADOPTION OVERRIDE — normally leave this commented out.
// ---------------------------------------------------------------------------
// Uncomment and set ONLY to adopt a board into a devices.hardware_id that
// already exists in the platform. The normal path derives the id from the
// board's MAC and needs nothing here.
//
// When it is needed: a device row registered through the admin portal with the
// Hardware ID field left blank gets a RANDOM id (esp32- + 6 random bytes). That
// can never equal a MAC-derived id, so the board self-provisions as a separate
// unclaimed row and never receives the ha/<id>/relay/<n>/set commands the app
// publishes to the claimed row. Pinning the id here makes the topics, the
// dev-<id> broker user and its ha/<id>/# ACL all agree.
//
// WARNING: an override pins exactly ONE physical unit. Never flash a secrets.h
// carrying one to a second board — both would fight over the same command and
// retained-state topics.
//
// #define SECRET_DEVICE_ID_OVERRIDE  "esp32-xxxxxxxxxxxx"
