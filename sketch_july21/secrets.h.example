#pragma once

// Copy this file to secrets.h and fill in real values.
// secrets.h is listed in .gitignore and must never be committed.

// --- WiFi (yours) ----------------------------------------------------------
#define SECRET_WIFI_SSID     ""
#define SECRET_WIFI_PASSWORD ""

// --- Device identity -------------------------------------------------------
// Must equal the board's hardware_id registered in the admin portal
// (Devices → Register device → "Hardware ID"). MQTT topics derive from it:
//   ha/<DEVICE_ID>/relay/<n>  and  ha/<DEVICE_ID>/status
#define SECRET_DEVICE_ID     "PdMHOx6Pg6EIo9tmpMvV"

// --- MQTT broker (EMQX Cloud Serverless — home-automation-broker) -----------
// These three are not secret; safe defaults for this project's broker.
#define SECRET_MQTT_HOST     "lb1d1698.ala.asia-southeast1.emqxsl.com"
#define SECRET_MQTT_PORT     8883
#define SECRET_MQTT_USER     "device-b805"

// Secret. Copy from home-automation-platform/.secrets/mqtt-credentials.txt
// (DEVICE_MQTT_PASSWORD). Never commit the real value.
#define SECRET_MQTT_PASS     ""

// --- TLS root CA (optional) -------------------------------------------------
// Leave empty for first bring-up (validation skipped). For production, paste
// the EMQX CA certificate (Console → Deployment Overview → CA Certificate),
// as a PEM string:
//   #define SECRET_MQTT_CA "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
